  "source": {
    "playstyles": "the twelve version-one playstyles; the role deltas are judgment calls, not fitted to data",
    "themes": "EDHREC theme slugs, checked against the tags sitemap EDHREC lists in its robots.txt: https://edhrec.com/sitemaps/tags.xml (read 2026-10-11)"
  },
  "field_notes": {
    "playstyles": "slug -> label, description (one plain sentence), themes (EDHREC slugs it pulls toward, counted at half weight), targets (role -> whole-number change to the bracket's role targets; negative means fewer), min_bracket (stax needs Bracket 4+).",
    "common_themes": "The menu shown when the commander is not known. With a commander, the menu is that commander's own EDHREC themes.",
    "known_themes": "Every EDHREC theme slug except the color-identity pages, so a typed --theme is checked against real slugs, not just the short menu.",
    "theme_matchers": "A weak fallback signal for a card's theme when no EDHREC page covers it. A card matches a theme when any of its subtypes is in 'subtypes', any of its types is in 'types', or any regex in 'text' matches its lowercased oracle text."
  },
  "playstyles": {
    "combat": {
      "label": "Combat",
      "description": "Win by attacking with efficient creatures, combat tricks and a way to push damage through.",
      "themes": [
        "aggro",
        "stompy",
        "extra-combats"
      ],
      "targets": {
        "finisher": 1,
        "protection": 1,
        "wipe": -1
      },
      "min_bracket": 1
    },
    "voltron": {
      "label": "Voltron",
      "description": "Win with one huge, well-protected threat, usually your commander carrying equipment and auras.",
      "themes": [
        "voltron",
        "equipment",
        "auras"
      ],
      "targets": {
        "protection": 2,
        "draw": 1,
        "wipe": -1
      },
      "min_bracket": 1
    },
    "go-wide": {
